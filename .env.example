# Configure these in your GPU host's secret/environment settings.
APP_USER=engineer
APP_PASSWORD=replace-with-your-own-strong-password
STUDIO_DATA=/data/projects
HF_HOME=/data/model-cache
CPU_OFFLOAD=1
PORT=7860
# Optional separate story-writing service. Base URL includes /v1.
WRITER_BASE_URL=
WRITER_MODEL=
WRITER_API_KEY=

# Optional YouTube automation. Secrets must live outside STUDIO_DATA.
YOUTUBE_SECRET_DIR=/data/youtube-secrets
YOUTUBE_CLIENT_SECRET_FILE=/data/youtube-secrets/client_secret.json
YOUTUBE_REDIRECT_URI=https://YOUR_STUDIO_HOST/youtube/callback
